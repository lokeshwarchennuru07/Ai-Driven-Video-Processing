# ============================================================
# 7. FEATURE EXTRACTION USING OPENCV
# ============================================================
#
# Since TensorFlow/PyTorch are not being used, we create
# simple visual features using OpenCV.
#
# Features:
#
# 1. Mean intensity
# 2. Standard deviation
# 3. Edge density
# 4. Motion
#
# These features form the input sequence for RNN/LSTM.
# ============================================================


def extract_frame_features(
    frames
):

    feature_sequence = []

    previous_gray = None


    for frame in frames:

        # Resize

        small = cv2.resize(
            frame,
            (128, 128)
        )


        # Convert to grayscale

        gray = cv2.cvtColor(
            small,
            cv2.COLOR_RGB2GRAY
        )


        # ----------------------------------------------------
        # Feature 1: Mean intensity
        # ----------------------------------------------------

        mean_intensity = np.mean(
            gray
        )


        # ----------------------------------------------------
        # Feature 2: Standard deviation
        # ----------------------------------------------------

        std_intensity = np.std(
            gray
        )


        # ----------------------------------------------------
        # Feature 3: Edge density
        # ----------------------------------------------------

        edges = cv2.Canny(
            gray,
            50,
            150
        )


        edge_density = np.mean(
            edges > 0
        )


        # ----------------------------------------------------
        # Feature 4: Motion
        # ----------------------------------------------------

        if previous_gray is None:

            motion = 0.0

        else:

            difference = cv2.absdiff(
                gray,
                previous_gray
            )


            motion = np.mean(
                difference
            )


        previous_gray = gray.copy()


        # ----------------------------------------------------
        # Create feature vector
        # ----------------------------------------------------

        feature_vector = np.array([

            mean_intensity,

            std_intensity,

            edge_density * 255,

            motion

        ])


        feature_sequence.append(
            feature_vector
        )


    return np.array(
        feature_sequence
    )


