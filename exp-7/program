# ============================================================
# 13. LSTM IMPLEMENTATION
# ============================================================


class SimpleLSTM:

    def __init__(
        self,
        input_size,
        hidden_size
    ):

        self.input_size = input_size

        self.hidden_size = hidden_size


        np.random.seed(42)


        # Combined weight matrix
        #
        # Four gates:
        #
        # Forget
        # Input
        # Candidate
        # Output


        self.W = (

            np.random.randn(

                4 * hidden_size,

                input_size + hidden_size

            ) * 0.1

        )


        self.b = np.zeros(
            4 * hidden_size
        )


    def sigmoid(
        self,
        x
    ):

        x = np.clip(
            x,
            -50,
            50
        )

        return 1 / (
            1 + np.exp(-x)
        )


    def forward(
        self,
        sequence
    ):

        hidden = np.zeros(
            self.hidden_size
        )


        cell = np.zeros(
            self.hidden_size
        )


        hidden_states = []


        for x in sequence:

            # Combine input and previous hidden state

            combined = np.concatenate(
                [
                    x,
                    hidden
                ]
            )


            gates = (

                np.dot(
                    self.W,
                    combined
                )

                +

                self.b

            )


            # Split into four gates

            forget_gate = self.sigmoid(

                gates[
                    0:self.hidden_size
                ]

            )


            input_gate = self.sigmoid(

                gates[
                    self.hidden_size:
                    2 * self.hidden_size
                ]

            )


            candidate = np.tanh(

                gates[
                    2 * self.hidden_size:
                    3 * self.hidden_size
                ]

            )


            output_gate = self.sigmoid(

                gates[
                    3 * self.hidden_size:
                    4 * self.hidden_size
                ]

            )


            # Cell state

            cell = (

                forget_gate * cell

                +

                input_gate * candidate

            )


            # Hidden state

            hidden = (

                output_gate

                *

                np.tanh(cell)

            )


            hidden_states.append(
                hidden.copy()
            )


        return np.array(
            hidden_states
        )


