# ============================================================
# 4. EXTRACT VIDEO FRAMES
# ============================================================

def extract_frames(
    video_path,
    number_of_frames
):

    cap = cv2.VideoCapture(
        video_path
    )

    total = int(
        cap.get(
            cv2.CAP_PROP_FRAME_COUNT
        )
    )


    if total <= 0:

        cap.release()

        return []


    # Select equally spaced frames

    frame_numbers = np.linspace(
        0,
        total - 1,
        number_of_frames
    ).astype(int)


    frames = []


    for frame_number in frame_numbers:

        cap.set(
            cv2.CAP_PROP_POS_FRAMES,
            int(frame_number)
        )


        success, frame = cap.read()


        if success:

            # Convert BGR to RGB

            frame = cv2.cvtColor(
                frame,
                cv2.COLOR_BGR2RGB
            )


            frames.append(
                frame
            )


    cap.release()


    return frames


