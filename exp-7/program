# ============================================================
# 11. RNN IMPLEMENTATION
# ============================================================


class SimpleRNN:

    def __init__(
        self,
        input_size,
        hidden_size
    ):

        self.input_size = input_size

        self.hidden_size = hidden_size


        # Random initialization

        np.random.seed(42)


        self.Wx = (
            np.random.randn(
                hidden_size,
                input_size
            ) * 0.1
        )


        self.Wh = (
            np.random.randn(
                hidden_size,
                hidden_size
            ) * 0.1
        )


        self.b = np.zeros(
            hidden_size
        )


    def forward(
        self,
        sequence
    ):

        hidden = np.zeros(
            self.hidden_size
        )


        hidden_states = []


        for x in sequence:

            hidden = np.tanh(

                np.dot(
                    self.Wx,
                    x
                )

                +

                np.dot(
                    self.Wh,
                    hidden
                )

                +

                self.b

            )


            hidden_states.append(
                hidden.copy()
            )


        return np.array(
            hidden_states
        )


