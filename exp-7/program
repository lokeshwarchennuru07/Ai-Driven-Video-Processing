# ============================================================
# 15. ACTIVITY SCORE
# ============================================================
#
# This is a demonstration classifier.
#
# In a real trained system, the RNN/LSTM output would be
# connected to a trained Softmax classifier using labeled
# videos.
# ============================================================


def classify_activity(
    rnn_output,
    lstm_output,
    motion_values
):

    average_motion = np.mean(
        motion_values
    )


    temporal_variation = np.mean(
        np.abs(
            np.diff(
                lstm_output,
                axis=0
            )
        )
    )


    score = (
        average_motion
        +
        temporal_variation * 50
    )


    # Demonstration threshold

    if score > 5:

        activity = "Running / Fast Movement"

    else:

        activity = "Walking / Normal Movement"


    return activity, score


